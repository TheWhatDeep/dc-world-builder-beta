# Copy to .env (or set in your environment / docker-compose) and adjust.

# Network
CODEX_PORT=8787
CODEX_HOST=0.0.0.0

# Storage (defaults to ./data inside server/)
# CODEX_DATA_DIR=/data
# CODEX_DB=/data/codex.db
# CODEX_ASSETS_DIR=/data/assets

# Where the frontend lives (defaults to the repo root one level up from server/)
# CODEX_FRONTEND_DIR=/app/frontend

# Sessions
CODEX_SESSION_TTL_MS=2592000000
# Set true when serving over HTTPS (recommended in production behind a reverse proxy)
CODEX_SECURE_COOKIES=false

# Registration: 'closed' (admin creates users) or 'open' (anyone can sign up)
CODEX_REGISTRATION_MODE=closed

# Optional first-run admin bootstrap (created only if no users exist)
# CODEX_ADMIN_EMAIL=admin@example.com
# CODEX_ADMIN_PASSWORD=change-me-please

# Limits
CODEX_MAX_ASSET_BYTES=26214400
CODEX_IMAGE_MAX_DIM=2048
CODEX_THUMB_DIM=320
